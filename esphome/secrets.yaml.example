# Copy to secrets.yaml (same folder) and fill in your own values.
# secrets.yaml is in .gitignore, never commit it.

wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"

# API encryption keys: generate one per device, e.g. with
#   openssl rand -base64 32
deskbuddy_api_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"
musicbuddy_api_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"

# Password for the fallback hotspot (at least 8 characters)
deskbuddy_fallback_password: "change-me-please"
musicbuddy_fallback_password: "change-me-please"
